# Environment for the original Construct monolith. Copy to .env; secrets say change-me.
# API Configuration
# IMPORTANT: Must include /api suffix (e.g. https://api.construct.space/api)
# Without /api, OAuth and other API routes will fail auth middleware checks
VITE_API_BASE=https://api.example.com/api
VITE_API_KEY=change-me
VITE_FREEPIK_API_KEY=change-me

# Spaces Registry
VITE_SPACES_REGISTRY_URL=https://developer.example.com/api

# OAuth (accounts.construct.space) — uses PKCE, no client secret needed
VITE_ACCOUNTS_URL=https://accounts.example.com
VITE_OAUTH_CLIENT_ID=construct_app
VITE_POLAR_TOKEN=change-me
