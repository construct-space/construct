# API Configuration
# IMPORTANT: Must include /api suffix (e.g. https://api.construct.ninja/api)
# Without /api, OAuth and other API routes will fail auth middleware checks
VITE_API_BASE=https://api.construct.ninja/api
VITE_API_KEY=api
VITE_FREEPIK_API_KEY=

# Spaces Registry
VITE_SPACES_REGISTRY_URL=https://spaces.construct.ninja/api

# OAuth (accounts.construct.ninja) — uses PKCE, no client secret needed
VITE_ACCOUNTS_URL=https://accounts.construct.ninja
VITE_OAUTH_CLIENT_ID=construct_app
