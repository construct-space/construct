{
  "name": "construct-personal",
  "version": "0.2.6",
  "description": "Construct - AI-powered development environment",
  "author": "Construct Team",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src/",
    "check": "vue-tsc --noEmit && eslint src/",
    "lint:fix": "eslint src/ --fix",
    "context:build": "bash scripts/build-context.sh",
    "context:test": "cd ../context && go test ./... -v",
    "tauri": "cargo tauri",
    "tauri:dev": "bun run context:build && cargo tauri dev",
    "tauri:build": "bun run context:build && cargo tauri build",
    "tauri:build:mac": "bun run context:build && cargo tauri build --target aarch64-apple-darwin",
    "tauri:build:mac-x64": "bun run context:build && cargo tauri build --target x86_64-apple-darwin",
    "tauri:build:universal": "bash scripts/build-context-universal.sh && cargo tauri build --target universal-apple-darwin",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "@construct-space/sdk": "file:../construct-sdk",
    "@nicepkg/gpt-runner": "^1.2.9",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-deep-link": "^2.4.7",
    "@tauri-apps/plugin-dialog": "2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-positioner": "^2.3.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-sql": "^2.3.2",
    "@tauri-apps/plugin-store": "^2.4.2",
    "@tauri-apps/plugin-stronghold": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "@tauri-apps/plugin-upload": "^2.4.0",
    "@tauri-apps/plugin-websocket": "^2.4.2",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "@unovis/vue": "^1.6.4",
    "@vueuse/core": "^14.2.1",
    "@vueuse/integrations": "^14.2.1",
    "async-validator": "^4.2.5",
    "axios": "^1.13.5",
    "change-case": "^5.4.4",
    "date-fns": "^4.1.0",
    "dexie": "^4.3.0",
    "dompurify": "^3.3.1",
    "drauu": "^1.0.0",
    "focus-trap": "^8.0.0",
    "fuse.js": "^7.1.0",
    "idb-keyval": "^6.2.2",
    "jwt-decode": "^4.0.0",
    "marked": "^17.0.3",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "reka-ui": "^2.2.0",
    "tauri-plugin-context-menu": "^0.8.0",
    "universal-cookie": "^8.0.1",
    "vue": "^3.5.28",
    "vue-router": "^4.5.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify/vue": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.4",
    "@tauri-apps/cli": "^2.10.0",
    "@types/dompurify": "^3.2.0",
    "@types/marked": "^6.0.0",
    "@types/node": "^25.2.3",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.0.0",
    "eslint-plugin-vue": "^10.8.0",
    "lucide-vue-next": "^0.511.0",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "unplugin-auto-import": "^19.2.0",
    "unplugin-vue-components": "^28.5.0",
    "vite": "^6.3.5",
    "vitest": "^4.0.18",
    "vue-tsc": "^2.2.10"
  }
}
