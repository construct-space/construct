{
  "name": "construct-personal",
  "version": "0.2.0",
  "description": "Construct - AI-powered development environment",
  "author": "Construct Team",
  "type": "module",
  "private": true,
  "scripts": {
    "spaces:extract": "node scripts/extract-space-repos.mjs",
    "spaces:sync": "node scripts/sync-space-repos.mjs",
    "dev": "bun run spaces:sync && vite",
    "build": "bun run spaces:sync && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "context:build": "bash scripts/build-context.sh",
    "context:test": "cd ../context && go test ./... -v",
    "tauri": "cargo tauri",
    "tauri:dev": "bun run spaces:sync && bun run context:build && cargo tauri dev",
    "tauri:build": "bun run spaces:sync && bun run context:build && cargo tauri build",
    "tauri:build:mac": "bun run spaces:sync && bun run context:build && cargo tauri build --target aarch64-apple-darwin",
    "tauri:build:mac-x64": "bun run spaces:sync && bun run context:build && cargo tauri build --target x86_64-apple-darwin",
    "tauri:build:universal": "bun run spaces:sync && bash scripts/build-context-universal.sh && cargo tauri build --target universal-apple-darwin"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-deep-link": "^2.4.7",
    "@tauri-apps/plugin-dialog": "2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "@unovis/vue": "^1.6.4",
    "@vueuse/core": "^14.2.1",
    "@vueuse/integrations": "^14.2.1",
    "async-validator": "^4.2.5",
    "axios": "^1.13.5",
    "change-case": "^5.4.4",
    "date-fns": "^4.1.0",
    "dexie": "^4.3.0",
    "drauu": "^1.0.0",
    "focus-trap": "^8.0.0",
    "fuse.js": "^7.1.0",
    "idb-keyval": "^6.2.2",
    "jwt-decode": "^4.0.0",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "reka-ui": "^2.2.0",
    "universal-cookie": "^8.0.1",
    "vue": "^3.5.28",
    "vue-router": "^4.5.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify/vue": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.4",
    "@tauri-apps/cli": "^2.10.0",
    "@types/node": "^25.2.3",
    "@vitejs/plugin-vue": "^5.2.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.0.0",
    "eslint-plugin-vue": "^10.8.0",
    "lucide-vue-next": "^0.511.0",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "unplugin-auto-import": "^19.2.0",
    "unplugin-vue-components": "^28.5.0",
    "vite": "^6.3.5",
    "vue-tsc": "^2.2.10"
  }
}
