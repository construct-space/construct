              "content": "import 'package:dbcrypt/dbcrypt.dart';\n\nclass PasswordHelper {\n  static final _bcrypt = DBCrypt();\n\n  static String hash(String password) {\n    final salt = _bcrypt.gensaltWithRounds(12);\n    return _bcrypt.hashpw(password, salt);\n  }\n\n  static bool verify(String password, String hashed) {\n    return _bcrypt.checkpw(password, hashed);\n  }\n}\n"
