nal post = await Model<Post>().find(id);\n    47→    if (post == null) return json({'error': 'Not found'}, statusCode: 404);\n    48→\n    49→    // Update fields\n    50→    post.title = body['title'] as String? ?? post.title;\n    51→    post.slug = body['slug'] as String? ?? post.slug;\n    52→    post.content = body['content'] as String? ?? post.content;\n    53→    post.excerpt = body['excerpt'] as String? ?? post.excerpt;\n    54→    post.published = body['published'] as bool? ?? post.published;\n    55→\n    56→    await post.save();\n    57→    return json({'post': post.toJson()});\n    58→  });\n    59→\n    60→  // DELETE /api/posts/:id - Delete post\n    61→  server.delete('/api/posts/:id', (req) async {\n    62→    final id = int.tryParse(req.params['id'] ?? '');\n    63→    if (id == null) return json({'error': 'Invalid ID'}, statusCode: 400);\n    64→\n    65→    final post = await Model<Post>().find(id);\n    66→    if (post == null) return json({'error': 'Not found'}, statusCode: 404);\n    67→\n    68→    await post.destroy();\n    69→    return json({'success': true});\n    70→  });\n    71→}\n    72→"
