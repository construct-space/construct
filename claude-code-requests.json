              "content": "import 'package:duxt_orm/duxt_orm.dart';\n\nclass Todo extends Entity {\n  int? _id;\n  String title;\n  bool completed;\n  int userId;\n  DateTime? createdAt;\n\n  Todo({\n    int? id,\n    required this.title,\n    this.completed = false,\n    required this.userId,\n    this.createdAt,\n  }) : _id = id;\n\n  @override\n  dynamic get id => _id;\n\n  @override\n  set id(dynamic value) => _id = value as int?;\n\n  @override\n  Map<String, dynamic> toMap() => {\n        'title': title,\n        'completed': completed ? 1 : 0,\n        'user_id': userId,\n      };\n\n  Map<String, dynamic> toJson() => {\n        'id': id,\n        'title': title,\n        'completed': completed,\n        'user_id': userId,\n        'created_at': createdAt?.toIso8601String(),\n      };\n\n  factory Todo.fromRow(Map<String, dynamic> row) => Todo(\n        id: row['id'] as int?,\n        title: row['title'] as String,\n        completed: (row['completed'] as int?) == 1,\n        userId: row['user_id'] as int,\n        createdAt: row['created_at'] != null\n            ? DateTime.tryParse(row['created_at'] as String)\n            : null,\n      );\n\n  static void register() {\n    Entity.registerModel<Todo>(\n      Todo.fromRow,\n      schema: {\n        'id': Column.integer().primaryKey().autoIncrement(),\n        'title': Column.string(255).notNull(),\n        'completed': Column.boolean().defaultValue(false),\n        'user_id': Column.integer().notNull().references('users'),\n        'created_at': Column.dateTime().nullable(),\n        'updated_at': Column.dateTime().nullable(),\n      },\n    );\n  }\n}\n"
