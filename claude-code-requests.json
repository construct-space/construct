      {
        "name": "mcp__duxt__generate_code",
        "description": "Generate ready-to-use Dart code following Duxt framework patterns.",
        "input_schema": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "model",
