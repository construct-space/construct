            "content": "     1→import 'package:duxt/server.dart';\n     2→import 'package:duxt_orm/duxt_orm.dart';\n     3→import 'package:todo/models/post.dart';\n     4→\n     5→void registerPostRoutes(DuxtServer server) {\n     6→  // GET /api/posts - List all published posts\n     7→  server.get('/api/posts', (req) async {\n     8→    final posts = await Post.findAll(publishedOnly: true);\n     9→    return json({'posts': posts.map((p) => p.toJson()).toList()});\n    10→  });\n    11→\n    12→  // GET /api/posts/:slug - Get single post by slug\n    13→  server.get('/api/posts/:slug', (req) async {\n    14→    final slug = req.params['slug'];\n    15→    if (slug == null) return json({'error': 'Slug required'}, statusCode: 400);\n    16→\n    17→    final post = await Post.findBySlug(slug);\n    18→    if (post == null) return json({'error': 'Not found'}, statusCode: 404);\n    19→\n    20→    return json({'post': post.toJson()});\n    21→  });\n    22→\n    23→  // POST /api/posts - Create new post\n    24→  server.post('/api/posts', (req) async {\n    25→    final body = req.body as Map<String, dynamic>?;\n    26→    if (body == null) return json({'error': 'Body required'}, statusCode: 400);\n    27→\n    28→    try {\n    29→      final post = Post.fromJson(body);\n    30→      await post.save();\n    31→      return json({'post': post.toJson()}, statusCode: 201);\n    32→    } catch (e) {\n    33→      print('Create failed: $e');\n    34→      return json({'error': 'Invalid request data'}, statusCode: 400);\n    35→    }\n    36→  });\n    37→\n    38→  // PUT /api/posts/:id - Update post\n    39→  server.put('/api/posts/:id', (req) async {\n    40→    final id = int.tryParse(req.params['id'] ?? '');\n    41→    if (id == null) return json({'error': 'Invalid ID'}, statusCode: 400);\n    42→\n    43→    final body = req.body as Map<String, dynamic>?;\n    44→    if (body == null) return json({'error': 'Body required'}, statusCode: 400);\n    45→\n    46→    final post = await Model<Post>().find(id);\n    47→    if (post == null) return json({'error': 'Not found'}, statusCode: 404);\n    48→\n    49→    // Update fields\n    50→    post.title = body['title'] as String? ?? post.title;\n    51→    post.slug = body['slug'] as String? ?? post.slug;\n    52→    post.content = body['content'] as String? ?? post.content;\n    53→    post.excerpt = body['excerpt'] as String? ?? post.excerpt;\n    54→    post.published = body['published'] as bool? ?? post.published;\n    55→\n    56→    await post.save();\n    57→    return json({'post': post.toJson()});\n    58→  });\n    59→\n    60→  // DELETE /api/posts/:id - Delete post\n    61→  server.delete('/api/posts/:id', (req) async {\n    62→    final id = int.tryParse(req.params['id'] ?? '');\n    63→    if (id == null) return json({'error': 'Invalid ID'}, statusCode: 400);\n    64→\n    65→    final post = await Model<Post>().find(id);\n    66→    if (post == null) return json({'error': 'Not found'}, statusCode: 404);\n    67→\n    68→    await post.destroy();\n    69→    return json({'success': true});\n    70→  });\n    71→}\n    72→"
