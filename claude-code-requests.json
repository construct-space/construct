              "content": "import 'package:duxt/server.dart';\nimport '../utils/session_manager.dart';\n\n/// Extracts the session_token cookie, validates the session, and attaches\n/// the authenticated User to `req.context['user']`.\n/// Returns an ApiResponse(401) if the session is missing or invalid.\nFuture<ApiResponse?> authMiddleware(ApiRequest req) async {\n  final cookieHeader = req.headers['cookie'] ?? '';\n  final token = _extractCookie(cookieHeader, 'session_token');\n\n  if (token == null || token.isEmpty) {\n    return ApiResponse.unauthorized('Authentication required');\n  }\n\n  final user = await SessionManager.getUserFromToken(token);\n  if (user == null) {\n    return ApiResponse.unauthorized('Invalid or expired session');\n  }\n\n  req.context['user'] = user;\n  return null; // continue to route handler\n}\n\nString? _extractCookie(String cookieHeader, String name) {\n  final cookies = cookieHeader.split(';');\n  for (final cookie in cookies) {\n    final parts = cookie.trim().split('=');\n    if (parts.length == 2 && parts[0].trim() == name) {\n      return parts[1].trim();\n    }\n  }\n  return null;\n}\n"
