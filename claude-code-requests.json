    "system": [
      {
        "type": "text",
        "text": "x-anthropic-billing-header: cc_version=2.1.50.b97; cc_entrypoint=cli; cch=38bd8;"
      },
      {
        "type": "text",
        "text": "You are Claude Code, Anthropic's official CLI for Claude.",
        "cache_control": {
          "type": "ephemeral",
          "ttl": "1h"
        }
