              "file_path": "/Users/flakerimi/TMP/todo/server/api/auth.dart",
              "content": "import 'package:duxt/server.dart';\nimport 'package:todo/models/user.dart';\nimport '../middleware/auth_middleware.dart';\nimport '../utils/password.dart';\nimport '../utils/session_manager.dart';\n\nconst _cookieFlags = 'HttpOnly; SameSite=Strict; Path=/; Max-Age=86400';\n\nvoid registerAuthApi(DuxtServer server) {\n  // POST /api/auth/register\n  server.post('/api/auth/register', (req) async {\n    final body = req.body as Map<String, dynamic>?;\n    if (body == null) {\n      return json({'error': 'Request body required'}, statusCode: 400);\n    }\n\n    final email = (body['email'] as String?)?.trim();\n    final password = body['password'] as String?;\n    final name = (body['name'] as String?)?.trim();\n\n    if (email == null || email.isEmpty) {\n      return json({'error': 'Email is required'}, statusCode: 400);\n    }\n    if (password == null || password.length < 6) {\n      return json({'error': 'Password must be at least 6 characters'},\n          statusCode: 400);\n    }\n    if (name == null || name.isEmpty) {\n      return json({'error': 'Name is required'}, statusCode: 400);\n    }\n\n    // Check for existing user\n    final existing = await User.findByEmail(email);\n    if (existing != null) {\n      return json({'error': 'Email already registered'}, statusCode: 409);\n    }\n\n    // Create user\n    final hashedPassword = PasswordHelper.hash(password);\n    final user = User(\n      email: email,\n      password: hashedPassword,\n      name: name,\n    );\n    await user.save();\n\n    // Create session\n    final token = await SessionManager.createSession(user.id as int);\n\n    return json(\n      {'user': user.toSafeMap()},\n      statusCode: 201,\n      headers: {'Set-Cookie': 'session_token=$token; $_cookieFlags'},\n    );\n  });\n\n  // POST /api/auth/login\n  server.post('/api/auth/login', (req) async {\n    final body = req.body as Map<String, dynamic>?;\n    if (body == null) {\n      return json({'error': 'Request body required'}, statusCode: 400);\n    }\n\n    final email = (body['email'] as String?)?.trim();\n    final password = body['password'] as String?;\n\n    if (email == null ||\n        email.isEmpty ||\n        password == null ||\n        password.isEmpty) {\n      return json({'error': 'Email and password are required'},\n          statusCode: 400);\n    }\n\n    final user = await User.findByEmail(email);\n    if (user == null || !PasswordHelper.verify(password, user.password)) {\n      return json({'error': 'Invalid email or password'}, statusCode: 401);\n    }\n\n    final token = await SessionManager.createSession(user.id as int);\n\n    return json(\n      {'user': user.toSafeMap()},\n      headers: {'Set-Cookie': 'session_token=$token; $_cookieFlags'},\n    );\n  });\n\n  // POST /api/auth/logout\n  server.post('/api/auth/logout', (req) async {\n    final user = await getAuthUser(req);\n    if (user == null) {\n      return json({'error': 'Authentication required'}, statusCode: 401);\n    }\n\n    final cookieHeader = req.headers['cookie'] ?? '';\n    final token = extractCookie(cookieHeader, 'session_token');\n    if (token != null) {\n      await SessionManager.deleteSession(token);\n    }\n\n    return json(\n      {'message': 'Logged out'},\n      headers: {\n        'Set-Cookie':\n            'session_token=; HttpOnly; SameSite=Strict; Path=/; Max-Age=0'\n      },\n    );\n  });\n\n  // GET /api/auth/me\n  server.get('/api/auth/me', (req) async {\n    final user = await getAuthUser(req);\n    if (user == null) {\n      return json({'error': 'Authentication required'}, statusCode: 401);\n    }\n\n    return json({'user': user.toSafeMap()});\n  });\n}\n"
