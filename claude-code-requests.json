              "content": "import 'package:shelf/shelf.dart';\nimport 'package:todo/models/user.dart';\nimport '../utils/session_manager.dart';\n\n/// Extracts the session_token cookie, validates the session, and returns\n/// the authenticated User or null if invalid.\nFuture<User?> getAuthUser(Request req) async {\n  final cookieHeader = req.headers['cookie'] ?? '';\n  final token = extractCookie(cookieHeader, 'session_token');\n\n  if (token == null || token.isEmpty) return null;\n\n  return SessionManager.getUserFromToken(token);\n}\n\nString? extractCookie(String cookieHeader, String name) {\n  final cookies = cookieHeader.split(';');\n  for (final cookie in cookies) {\n    final parts = cookie.trim().split('=');\n    if (parts.length == 2 && parts[0].trim() == name) {\n      return parts[1].trim();\n    }\n  }\n  return null;\n}\n"
