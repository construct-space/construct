method:$path'] = handler;\n    60→    }\n    61→  }\n    62→\n    63→  /// Register an API handler class\n    64→  void use(String path, ApiHandler handler) {\n    65→    get(path, (req) => _handleApi(req, handler.get));\n    66→    post(path, (req) => _handleApi(req, handler.post));\n    67→    put(path, (req) => _handleApi(req, handler.put));\n    68→    delete(path, (req) => _handleApi(req, handler.delete));\n    69→    patch(path, (req) => _handleApi(req, handler.patch));\n    70→  }\n    71→\n    72→  Future<Response> _handleApi(\n    73→    Request request,\n    74→    Future<ApiResponse> Function(ApiRequest) handler,\n    75→  ) async {\n    76→    final body = await request.readAsString();\n    77→    final apiRequest = ApiRequest(\n    78→      method: request.method,\n    79→      path: request.url.path,\n    80→      params: {}, // Will be populated by router\n    81→      query: request.url.queryParameters,\n    82→      headers: request.headers,\n    83→      body: body,\n    84→    );\n    85→\n    86→    try {\n    87→      final apiResponse = await handler(apiRequest);\n    88→      return Response(\n    89→        apiResponse.statusCode,\n    90→        body: apiResponse.toJson(),\n    91→        headers: {\n    92→          'Content-Type': 'application/json',\n    93→          ...apiResponse.headers,\n    94→        },\n    95→      );\n    96→    } catch (e) {\n    97→      // Log full error server-side, return generic message to client\n    98→      print('\\x1B[31m[error]\\x1B[0m API handler failed: $e');\n    99→      return Response.internalServerError(\n   100→        body: jsonEncode({'error': 'Internal server error'}),\n   101→        headers: {\n   102→          'Content-Type': 'application/json',\n   103→          'X-Content-Type-Options': 'nosniff',\n   104→        },\n   105→      );\n   106→    }\n   107→  }\n   108→\n   109→  /// Main request handler\n   110→  Handler get handler {\n   111→    return (Request request) async {\n   112→      final method = request.method;\n   113→      final path = '/${request.url.path}';\n   114→\n   115→      // Try exact match\n   116→      final key = '$method:$path';\n   117→      if (_routes.containsKey(key)) {\n   118→        return _routes[key]!(request);\n   119→      }\n   120→\n   121→      // Try pattern matching for dynamic routes\n   122→      for (final entry in _routes.entries) {\n   123→        final routeKey = entry.key;\n   124→        if (!routeKey.startsWith('$method:')) continue;\n   125→\n   126→        final routePath = routeKey.substring(method.length + 1);\n   127→        final params = _matchRoute(routePath, path);\n   128→        if (params != null) {\n   129→          // Add params to request context\n   130→          final newRequest = request.change(context: {\n   131→            ...request.context,\n   132→            'params': params,\n   133→          });\n   134→          return entry.value(newRequest);\n   135→        }\n   136→      }\n   137→\n   138→      // Try serving static files if staticDir is set\n   139→      if (staticDir != null) {\n   140→        final staticHandler = createStaticHandler(\n   141→          staticDir!,\n   142→          defaultDocument: 'index.html',\n   143→        );\n   144→        final staticResponse = await staticHandler(request);\n   145→        if (staticResponse.statusCode != 404) {\n   146→          return staticResponse;\n   147→        }\n   148→        // For SPA routing, try serving index.html for HTML requests\n   149→        if (request.headers['accept']?.contains('text/html') ?? false) {\n   150→          final indexFile = File('$staticDir/index.html');\n   151→          if (indexFile.existsSync()) {\n   152→            return Response.ok(\n   153→              indexFile.readAsStringSync(),\n   154→              headers: {'Content-Type': 'text/html'},\n   155→            );\n   156→          }\n   157→        }\n   158→      }\n   159→\n   160→      // Content-negotiated 404: HTML for browsers, JSON for API clients\n   161→      final accept = request.headers['accept'] ?? '';\n   162→      if (accept.contains('text/html')) {\n   163→        return Response.notFound(\n   164→          DuxtErrorHtml.notFound(path: path),\n   165→          headers: {\n   166→            'Content-Type': 'text/html',\n   167→            'Vary': 'Accept',\n   168→            'X-Content-Type-Options': 'nosniff',\n   169→            'X-Frame-Options': 'DENY',\n   170→          },\n   171→        );\n   172→      }\n   173→      return Response.notFound(\n   174→        jsonEncode({'error': 'Not found'}),\n   175→        headers: {\n   176→          'Content-Type': 'application/json',\n   177→          'Vary': 'Accept',\n   178→          'X-Content-Type-Options': 'nosniff',\n   179→        },\n   180→      );\n   181→    };\n   182→  }\n   183→\n   184→  /// Match route pattern to path\n   185→  Map<String, String>? _matchRoute(String pattern, String path) {\n   186→    final patternParts = pattern.split('/').where((p) => p.isNotEmpty).toList();\n   187→    final pathParts = path.split('/').where((p) => p.isNotEmpty).toList();\n   188→\n   189→    if (patternParts.length != pathParts.length) return null;\n   190→\n   191→    final params = <String, String>{};\n   192→    for (var i = 0; i < patternParts.length; i++) {\n   193→      final patternPart = patternParts[i];\n   194→      final pathPart = pathParts[i];\n   195→\n   196→      if (patternPart.startsWith(':')) {\n   197→        params[patternPart.substring(1)] = pathPart;\n   198→      } else if (patternPart != pathPart) {\n   199→        return null;\n   200→      }\n   201→    }\n   202→    return params;\n   203→  }\n   204→\n   205→  /// Build the pipeline with middleware\n   206→  Handler get pipeline {\n   207→    var h = handler;\n   208→    for (final m in middleware.reversed) {\n   209→      h = m(h);\n   210→    }\n   211→    return h;\n   212→  }\n   213→\n   214→  /// Start the server\n   215→  Future<void> start() async {\n   216→    _server = await shelf_io.serve(pipeline, InternetAddress.anyIPv4, port);\n   217→    _server!.idleTimeout = requestTimeout;\n   218→    print('Server running at http://localhost:$port');\n   219→\n   220→    // Graceful shutdown on SIGINT and SIGTERM\n   221→    _sigintSub = ProcessSignal.sigint.watch().listen((_) => _shutdown());\n   222→    if (!Platform.isWindows) {\n   223→      _sigtermSub = ProcessSignal.sigterm.watch().listen((_) => _shutdown());\n   224→    }\n   225→  }\n   226→\n   227→  Future<void> _shutdown() async {\n   228→    print('\\nShutting down gracefully...');\n   229→    await stop();\n   230→    exit(0);\n   231→  }\n   232→\n   233→  /// Stop the server\n   234→  Future<void> stop() async {\n   235→    _sigintSub?.cancel();\n   236→    _sigtermSub?.cancel();\n   237→    await _server?.close();\n   238→    _server = null;\n   239→  }\n   240→}\n   241→\n   242→/// CORS middleware\n   243→///\n   244→/// By default, no origins are allowed. You must explicitly specify allowed origins.\n   245→/// Use `origins: ['*']` only for public APIs — never for authenticated endpoints.\n   246→Middleware cors({\n   247→  required List<String> origins,\n   248→  List<String> methods = const ['GET', 'POST', 'PUT', 'DELETE', 'PATCH', 'OPTIONS'],\n   249→  List<String> headers = const ['Content-Type', 'Authorization'],\n   250→}) {\n   251→  return (Handler innerHandler) {\n   252→    return (Request request) async {\n   253→      final origin = request.headers['origin'] ?? '';\n   254→      final allowedOrigin = origins.contains('*') ? '*' : (origins.contains(origin) ? origin : null);\n   255→\n   256→      if (request.method == 'OPTIONS') {\n   257→        return Response.ok('', headers: {\n   258→          if (allowedOrigin != null) 'Access-Control-Allow-Origin': allowedOrigin,\n   259→          'Access-Control-Allow-Methods': methods.join(', '),\n   260→          'Access-Control-Allow-Headers': headers.join(', '),\n   261→        });\n   262→      }\n   263→\n   264→      final response = await innerHandler(request);\n   265→      return response.change(headers: {\n   266→        ...response.headers,\n   267→        if (allowedOrigin != null) 'Access-Control-Allow-Origin': allowedOrigin,\n   268→      });\n   269→    };\n   270→  };\n   271→}\n   272→\n   273→/// Security headers middleware — adds standard security headers to all responses\n   274→Middleware securityHeaders() {\n   275→  return (Handler innerHandler) {\n   276→    return (Request request) async {\n   277→      final response = await innerHandler(request);\n   278→      return response.change(headers: {\n   279→        ...response.headers,\n   280→        'X-Content-Type-Options': 'nosniff',\n   281→        'X-Frame-Options': 'DENY',\n   282→        'X-XSS-Protection': '1; mode=block',\n   283→        'Referrer-Policy': 'strict-origin-when-cross-origin',\n   284→      });\n   285→    };\n   286→  };\n   287→}\n   288→\n   289→/// Request body size limit middleware\n   290→///\n   291→/// Rejects requests with Content-Length exceeding [maxBytes].\n   292→/// Default limit is 1 MB.\n   293→Middleware bodyLimit({int maxBytes = 1024 * 1024}) {\n   294→  return (Handler innerHandler) {\n   295→    return (Request request) async {\n   296→      final contentLength = request.contentLength;\n   297→      if (contentLength != null && contentLength > maxBytes) {\n   298→        return Response(\n   299→          413,\n   300→          body: jsonEncode({'error': 'Request body too large'}),\n   301→          headers: {'Content-Type': 'application/json'},\n   302→        );\n   303→      }\n   304→      return innerHandler(request);\n   305→    };\n   306→  };\n   307→}\n   308→\n   309→/// Rate limiting middleware\n   310→///\n   311→/// Limits each IP to [maxRequests] per [window]. Uses in-memory storage.\n   312→Middleware rateLimit({\n   313→  int maxRequests = 100,\n   314→  Duration window = const Duration(minutes: 1),\n   315→}) {\n   316→  final _requests = <String, List<DateTime>>{};\n   317→\n   318→  return (Handler innerHandler) {\n   319→    return (Request request) async {\n   320→      final ip = (request.context['shelf.io.connection_info'] as HttpConnectionInfo?)\n   321→          ?.remoteAddress.address ?? 'unknown';\n   322→      final now = DateTime.now();\n   323→      final cutoff = now.subtract(window);\n   324→\n   325→      // Clean old entries and add current\n   326→      final timestamps = (_requests[ip] ?? [])\n   327→          .where((t) => t.isAfter(cutoff))\n   328→          .toList()\n   329→        ..add(now);\n   330→      _requests[ip] = timestamps;\n   331→\n   332→      if (timestamps.length > maxRequests) {\n   333→        return Response(\n   334→          429,\n   335→          body: jsonEncode({'error': 'Too many requests'}),\n   336→          headers: {\n   337→            'Content-Type': 'application/json',\n   338→            'Retry-After': window.inSeconds.toString(),\n   339→          },\n   340→        );\n   341→      }\n   342→\n   343→      return innerHandler(request);\n   344→    };\n   345→  };\n   346→}\n   347→\n   348→/// Request timeout middleware\n   349→///\n   350→/// Returns 504 Gateway Timeout if the handler takes longer than [duration].\n   351→Middleware timeout({Duration duration = const Duration(seconds: 30)}) {\n   352→  return (Handler innerHandler) {\n   353→    return (Request request) async {\n   354→      try {\n   355→        return await Future.any<Response>([\n   356→          Future(() async => await innerHandler(request)),\n   357→          Future.delayed(duration, () => Response(\n   358→            504,\n   359→            body: jsonEncode({'error': 'Request timeout'}),\n   360→            headers: {'Content-Type': 'application/json'},\n   361→          )),\n   362→        ]);\n   363→      } catch (e) {\n   364→        return Response.internalServerError(\n   365→          body: jsonEncode({'error': 'Internal server error'}),\n   366→          headers: {'Content-Type': 'application/json'},\n   367→        );\n   368→      }\n   369→    };\n   370→  };\n   371→}\n   372→\n   373→/// JSON body parser middleware\n   374→Middleware jsonBody() {\n   375→  return (Handler innerHandler) {\n   376→    return (Request request) async {\n   377→      if (request.method == 'GET' || request.method == 'HEAD') {\n   378→        return innerHandler(request);\n   379→      }\n   380→\n   381→      final contentType = request.headers['content-type'] ?? '';\n   382→      if (!contentType.contains('application/json')) {\n   383→        return innerHandler(request);\n   384→      }\n   385→\n   386→      final body = await request.readAsString();\n   387→      final json = body.isNotEmpty ? jsonDecode(body) : null;\n   388→\n   389→      return innerHandler(request.change(context: {\n   390→        ...request.context,\n   391→        'body': json,\n   392→        'rawBody': body,\n   393→      }));\n   394→    };\n   395→  };\n   396→}\n   397→\n   398→/// Logger middleware\n   399→Middleware logger() {\n   400→  return (Handler innerHandler) {\n   401→    return (Request request) async {\n   402→      final stopwatch = Stopwatch()..start();\n   403→      final response = await innerHandler(request);\n   404→      stopwatch.stop();\n   405→\n   406→      final status = response.statusCode;\n   407→      final color = status < 400 ? '\\x1B[32m' : '\\x1B[31m';\n   408→      print('${request.method} ${request.url.path} $color$status\\x1B[0m ${stopwatch.elapsedMilliseconds}ms');\n   409→\n   410→      return response;\n   411→    };\n   412→  };\n   413→}\n   414→\n   415→/// Auth middleware\n   416→Middleware auth(Future<bool> Function(Request) verify) {\n   417→  return (Handler innerHandler) {\n   418→    return (Request request) async {\n   419→      if (!await verify(request)) {\n   420→        return Response.unauthorized(\n   421→          jsonEncode({'error': 'Unauthorized'}),\n   422→          headers: {'Content-Type': 'application/json'},\n   423→        );\n   424→      }\n   425→      return innerHandler(request);\n   426→    };\n   427→  };\n   428→}\n   429→\n   430→/// CSRF protection middleware\n   431→///\n   432→/// Validates that state-changing requests (POST, PUT, DELETE, PATCH) include\n   433→/// a matching CSRF token in the header. GET/HEAD/OPTIONS are always allowed.\n   434→Middleware csrf({String headerName = 'X-CSRF-Token', String cookieName = 'csrf_token'}) {\n   435→  return (Handler innerHandler) {\n   436→    return (Request request) async {\n   437→      final safeMethods = {'GET', 'HEAD', 'OPTIONS'};\n   438→      if (safeMethods.contains(request.method)) {\n   439→        return innerHandler(request);\n   440→      }\n   441→\n   442→      final cookieHeader = request.headers['cookie'] ?? '';\n   443→      final cookies = _parseCookies(cookieHeader);\n   444→      final cookieToken = cookies[cookieName];\n   445→      final headerToken = request.headers[headerName.toLowerCase()];\n   446→\n   447→      if (cookieToken == null || cookieToken.isEmpty ||\n   448→          headerToken == null || headerToken != cookieToken) {\n   449→        return Response.forbidden(\n   450→          jsonEncode({'error': 'CSRF token mismatch'}),\n   451→          headers: {'Content-Type': 'application/json'},\n   452→        );\n   453→      }\n   454→\n   455→      return innerHandler(request);\n   456→    };\n   457→  };\n   458→}\n   459→\n   460→Map<String, String> _parseCookies(String cookieHeader) {\n   461→  final cookies = <String, String>{};\n   462→  for (final part in cookieHeader.split(';')) {\n   463→    final trimmed = part.trim();\n   464→    final eq = trimmed.indexOf('=');\n   465→    if (eq > 0) {\n   466→      cookies[trimmed.substring(0, eq)] = trimmed.substring(eq + 1);\n   467→    }\n   468→  }\n   469→  return cookies;\n   470→}\n   471→\n   472→/// Extension to get parsed data from request\n   473→extension RequestExtens