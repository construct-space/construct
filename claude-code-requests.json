            "content": "1→import 'package:duxt/server.dart';\n     2→import '../utils/session_manager.dart';\n     3→\n     4→/// Extracts the session_token cookie, validates the session, and attaches\n     5→/// the authenticated User to `req.context['user']`.\n     6→/// Returns an ApiResponse(401) if the session is missing or invalid.\n     7→Future<ApiResponse?> authMiddleware(ApiRequest req) async {\n     8→  final cookieHeader = req.headers['cookie'] ?? '';\n     9→  final token = _extractCookie(cookieHeader, 'session_token');\n    10→\n    11→  if (token == null || token.isEmpty) {\n    12→    return ApiResponse.unauthorized('Authentication required');\n    13→  }\n    14→\n    15→  final user = await SessionManager.getUserFromToken(token);\n    16→  if (user == null) {\n    17→    return ApiResponse.unauthorized('Invalid or expired session');\n    18→  }\n    19→\n    20→  req.context['user'] = user;\n    21→  return null; // continue to route handler\n    22→}\n    23→\n    24→String? _extractCookie(String cookieHeader, String name) {\n    25→  final cookies = cookieHeader.split(';');\n    26→  for (final cookie in cookies) {\n    27→    final parts = cookie.trim().split('=');\n    28→    if (parts.length == 2 && parts[0].trim() == name) {\n    29→      return parts[1].trim();\n    30→    }\n    31→  }\n    32→  return null;\n    33→}\n    34→\n\n<system-reminder>\nCRITICAL: This is a READ-ONLY task. You CANNOT edit, write, or create files.\n</system-reminder>",
