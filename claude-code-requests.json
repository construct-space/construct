            "content": "1→import 'dart:convert';\n     2→\n     3→/// Base class for API route handlers\n     4→/// Handles HTTP methods for server-side API routes\n     5→abstract class ApiHandler {\n     6→  /// Handle GET requests\n     7→  Future<ApiResponse> get(ApiRequest request) async {\n     8→    return ApiResponse.methodNotAllowed();\n     9→  }\n    10→\n    11→  /// Handle POST requests\n    12→  Future<ApiResponse> post(ApiRequest request) async {\n    13→    return ApiResponse.methodNotAllowed();\n    14→  }\n    15→\n    16→  /// Handle PUT requests\n    17→  Future<ApiResponse> put(ApiRequest request) async {\n    18→    return ApiResponse.methodNotAllowed();\n    19→  }\n    20→\n    21→  /// Handle DELETE requests\n    22→  Future<ApiResponse> delete(ApiRequest request) async {\n    23→    return ApiResponse.methodNotAllowed();\n    24→  }\n    25→\n    26→  /// Handle PATCH requests\n    27→  Future<ApiResponse> patch(ApiRequest request) async {\n    28→    return ApiResponse.methodNotAllowed();\n    29→  }\n    30→\n    31→  /// Handle any method (catch-all)\n    32→  Future<ApiResponse> handler(ApiRequest request) async {\n    33→    switch (request.method) {\n    34→      case 'GET':\n    35→        return get(request);\n    36→      case 'POST':\n    37→        return post(request);\n    38→      case 'PUT':\n    39→        return put(request);\n    40→      case 'DELETE':\n    41→        return delete(request);\n    42→      case 'PATCH':\n    43→        return patch(request);\n    44→      default:\n    45→        return ApiResponse.methodNotAllowed();\n    46→    }\n    47→  }\n    48→}\n    49→\n    50→/// Incoming API request\n    51→class ApiRequest {\n    52→  final String method;\n    53→  final String path;\n    54→  final Map<String, String> params;\n    55→  final Map<String, String> query;\n    56→  final Map<String, String> headers;\n    57→  final String? body;\n    58→\n    59→  ApiRequest({\n    60→    required this.method,\n    61→    required this.path,\n    62→    this.params = const {},\n    63→    this.query = const {},\n    64→    this.headers = const {},\n    65→    this.body,\n    66→  });\n    67→\n    68→  /// Parse body as JSON\n    69→  dynamic get json {\n    70→    if (body == null || body!.isEmpty) return null;\n    71→    return jsonDecode(body!);\n    72→  }\n    73→\n    74→  /// Get a specific query parameter\n    75→  String? getQuery(String key) => query[key];\n    76→\n    77→  /// Get a specific path parameter\n    78→  String? getParam(String key) => params[key];\n    79→\n    80→  /// Get a specific header\n    81→  String? getHeader(String key) => headers[key.toLowerCase()];\n    82→}\n    83→\n    84→/// API response\n    85→class ApiResponse {\n    86→  final int statusCode;\n    87→  final dynamic data;\n    88→  final Map<String, String> headers;\n    89→\n    90→  ApiResponse({\n    91→    required this.statusCode,\n    92→    this.data,\n    93→    this.headers = const {},\n    94→  });\n    95→\n    96→  /// Success response with JSON data\n    97→  factory ApiResponse.json(dynamic data, {int statusCode = 200}) {\n    98→    return ApiResponse(\n    99→      statusCode: statusCode,\n   100→      data: data,\n   101→      headers: {'Content-Type': 'application/json'},\n   102→    );\n   103→  }\n   104→\n   105→  /// Success response\n   106→  factory ApiResponse.ok([dynamic data]) {\n   107→    return ApiResponse.json(data ?? {'success': true});\n   108→  }\n   109→\n   110→  /// Created response (201)\n   111→  factory ApiResponse.created([dynamic data]) {\n   112→    return ApiResponse.json(data ?? {'success': true}, statusCode: 201);\n   113→  }\n   114→\n   115→  /// No content response (204)\n   116→  factory ApiResponse.noContent() {\n   117→    return ApiResponse(statusCode: 204);\n   118→  }\n   119→\n   120→  /// Bad request response (400)\n   121→  factory ApiResponse.badRequest([String? message]) {\n   122→    return ApiResponse.json(\n   123→ 