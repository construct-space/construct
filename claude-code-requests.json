            "content": "1→import 'dart:convert';\n     2→\n     3→/// Base class for API route handlers\n     4→/// Handles HTTP methods for server-side API routes\n     5→abstract class ApiHandler {\n     6→  /// Handle GET requests\n     7→  Future<ApiResponse> get(ApiRequest request) async {\n     8→    return ApiResponse.methodNotAllowed();\n     9→  }\n    10→\n    11→  /// Handle POST requests\n    12→  Future<ApiResponse> post(ApiRequest request) async {\n    13→    return ApiResponse.methodNotAllowed();\n    14→  }\n    15→\n    16→  /// Handle PUT requests\n    17→  Future<ApiResponse> put(ApiRequest request) async {\n    18→    return ApiResponse.methodNotAllowed();\n    19→  }\n    20→\n    21→  /// Handle DELETE requests\n    22→  Future<ApiResponse> delete(ApiRequest request) async {\n    23→    return ApiResponse.methodNotAllowed();\n    24→  }\n    25→\n    26→  /// Handle PATCH requests\n    27→  Future<ApiResponse> patch(ApiRequest request) async {\n    28→    return ApiResponse.methodNotAllowed();\n    29→  }\n    30→\n    31→  /// Handle any method (catch-all)\n    32→  Future<ApiResponse> handler(ApiRequest request) async {\n    33→    switch (request.method) {\n    34→      case 'GET':\n    35→        return get(request);\n    36→      case 'POST':\n    37→        return post(request);\n    38→      case 'PUT':\n    39→        return put(request);\n    40→      case 'DELETE':\n    41→        return delete(request);\n    42→      case 'PATCH':\n    43→        return patch(request);\n    44→      default:\n    45→        return ApiResponse.methodNotAllowed();\n    46→    }\n    47→  }\n    48→}\n    49→\n    50→/// Incoming API request\n    51→class ApiRequest {\n    52→  final String method;\n    53→  final String path;\n    54→  final Map<String, String> params;\n    55→  final Map<String, String> query;\n    56→  final Map<String, String> headers;\n    57→  final String? body;\n    58→\n    59→  ApiRequest({\n    60→    required this.method,\n 