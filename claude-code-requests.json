              "file_path": "/Users/flakerimi/TMP/todo/server/utils/session_manager.dart",
              "content": "import 'package:duxt_orm/duxt_orm.dart';\nimport 'package:uuid/uuid.dart';\nimport 'package:todo/models/session.dart';\nimport 'package:todo/models/user.dart';\n\nclass SessionManager {\n  static const _sessionDuration = Duration(hours: 24);\n  static final _uuid = Uuid();\n\n  /// Creates a new session for the given user ID and returns the token.\n  static Future<String> createSession(int userId) async {\n    final token = _uuid.v4();\n    final expiresAt = DateTime.now().add(_sessionDuration).toIso8601String();\n\n    final session = Session(\n      token: token,\n      userId: userId,\n      expiresAt: expiresAt,\n    );\n    await session.save();\n\n    return token;\n  }\n\n  /// Looks up a session by token and returns the associated User, or null.\n  static Future<User?> getUserFromToken(String token) async {\n    final session =\n        await Model<Session>().query().where('token', token).first();\n\n    if (session == null || session.isExpired) {\n      // Clean up expired session\n      if (session != null) await session.forceDelete();\n      return null;\n    }\n\n    return Model<User>().find(session.userId);\n  }\n\n  /// Deletes a session by token (logout).\n  static Future<void> deleteSession(String token) async {\n    final session =\n        await Model<Session>().query().where('token', token).first();\n    if (session != null) {\n      await session.forceDelete();\n    }\n  }\n}\n"
            }
