            "input": {
              "file_path": "/Users/flakerimi/TMP/todo/server/api/todos.dart",
              "content": "import 'package:duxt/server.dart';\nimport 'package:duxt_orm/duxt_orm.dart';\nimport 'package:todo/models/todo.dart';\nimport 'package:todo/models/user.dart';\nimport '../middleware/auth_middleware.dart';\n\nvoid registerTodoApi(DuxtServer server) {\n  // GET /api/todos - List current user's todos\n  server.get('/api/todos', (req) async {\n    final authResult = await authMiddleware(req);\n    if (authResult != null) return authResult;\n\n    final user = req.context['user'] as User;\n    final todos = await Model<Todo>()\n        .query()\n        .where('user_id', user.id)\n        .orderByDesc('created_at')\n        .get();\n\n    return ApiResponse.ok({\n      'todos': todos.map((t) => t.toJson()).toList(),\n    });\n  });\n\n  // POST /api/todos - Create a todo\n  server.post('/api/todos', (req) async {\n    final authResult = await authMiddleware(req);\n    if (authResult != null) return authResult;\n\n    final user = req.context['user'] as User;\n    final body = req.json;\n    if (body == null) {\n      return ApiResponse.badRequest('Request body required');\n    }\n\n    final title = (body['title'] as String?)?.trim();\n    if (title == null || title.isEmpty) {\n      return ApiResponse.badRequest('Title is required');\n    }\n\n    final todo = Todo(\n      title: title,\n      completed: body['completed'] as bool? ?? false,\n      userId: user.id as int,\n    );\n    await todo.save();\n\n    return ApiResponse.created({'todo': todo.toJson()});\n  });\n\n  // GET /api/todos/:id - Get a single todo\n  server.get('/api/todos/:id', (req) async {\n    final authResult = await authMiddleware(req);\n    if (authResult != null) return authResult;\n\n    final user = req.context['user'] as User;\n    final id = int.tryParse(req.params['id'] ?? '');\n    if (id == null) {\n      return ApiResponse.badRequest('Invalid ID');\n    }\n\n    final todo = await Model<Todo>().find(id);\n    if (todo == null || todo.userId != user.id) {\n      return ApiResponse.notFound('Todo not found');\n    }\n\n    return ApiResponse.ok({'todo': todo.toJson()});\n  });\n\n  // PUT /api/todos/:id - Update a todo\n  server.put('/api/todos/:id', (req) async {\n    final authResult = await authMiddleware(req);\n    if (authResult != null) return authResult;\n\n    final user = req.context['user'] as User;\n    final id = int.tryParse(req.params['id'] ?? '');\n    if (id == null) {\n      return ApiResponse.badRequest('Invalid ID');\n    }\n\n    final todo = await Model<Todo>().find(id);\n    if (todo == null || todo.userId != user.id) {\n      return ApiResponse.notFound('Todo not found');\n    }\n\n    final body = req.json;\n    if (body == null) {\n      return ApiResponse.badRequest('Request body required');\n    }\n\n    todo.title = (body['title'] as String?)?.trim() ?? todo.title;\n    todo.completed = body['completed'] as bool? ?? todo.completed;\n\n    await todo.save();\n    return ApiResponse.ok({'todo': todo.toJson()});\n  });\n\n  // DELETE /api/todos/:id - Delete a todo\n  server.delete('/api/todos/:id', (req) async {\n    final authResult = await authMiddleware(req);\n    if (authResult != null) return authResult;\n\n    final user = req.context['user'] as User;\n    final id = int.tryParse(req.params['id'] ?? '');\n    if (id == null) {\n      return ApiResponse.badRequest('Invalid ID');\n    }\n\n    final todo = await Model<Todo>().find(id);\n    if (todo == null || todo.userId != user.id) {\n      return ApiResponse.notFound('Todo not found');\n    }\n\n    await todo.forceDelete();\n    return ApiResponse.ok({'message': 'Todo deleted'});\n  });\n}\n"
