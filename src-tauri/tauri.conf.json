{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Construct",
  "version": "0.2.8",
  "identifier": "space.construct.personal",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVEODJEMzhCQzM1MEJBRUMKUldUc3VsRERpOU9DWGVDYy9ZRmtrYkhOb1lIWSt0UElFR0RDa2xnOEZyOHZsajhDK0dRZnpZeTEK",
      "endpoints": [
        "https://github.com/construct-space/releases/releases/latest/download/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "construct",
          "antigravity"
        ]
      }
    }
  },
  "build": {
    "beforeDevCommand": "TAURI=true exec bun run dev",
    "devUrl": "http://localhost:3050",
    "beforeBuildCommand": "TAURI=true bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Construct",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "dragDropEnabled": true,
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "bin/construct-brain"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "frameworks": [],
      "entitlements": null
    },
    "windows": {
      "certificateThumbprint": null,
      "timestampUrl": null,
      "wix": null,
      "nsis": null
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
