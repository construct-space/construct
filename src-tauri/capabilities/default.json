{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Construct",
  "windows": ["main", "standalone-*", "browser-*", "oauth-login"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "shell:allow-open",
    "shell:allow-spawn",
    "shell:allow-execute",
    "shell:default",
    "fs:default",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-copy-file",
    "fs:allow-watch",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME" },
        { "path": "$HOME/**" },
        { "path": "$HOME/.*" },
        { "path": "$HOME/.*/**" },
        { "path": "$HOME/ConstructProjects" },
        { "path": "$HOME/ConstructProjects/**" },
        { "path": "$HOME/ConstructProjects/*/.construct" },
        { "path": "$HOME/ConstructProjects/*/.construct/**" },
        { "path": "$HOME/ConstructProjects/**/.construct" },
        { "path": "$HOME/ConstructProjects/**/.construct/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DESKTOP/**" },
        { "path": "/Volumes/**" },
        { "path": "/tmp/**" }
      ]
    },
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "core:window:allow-start-dragging",
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        { "url": "http://localhost:*" },
        { "url": "http://127.0.0.1:*" },
        { "url": "https://*" }
      ]
    },
    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:allow-restart",
    "process:allow-exit",
    "opener:default",
    "opener:allow-open-url",
    "deep-link:default",
    "sql:default",
    "core:webview:allow-create-webview-window"
  ]
}
